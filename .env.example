# 复制为 .env 后填写自己的 DeepSeek API Key。
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选：使用 --provider openai 或 claude 时填写对应密钥。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 可选：--desktop --vision-mode separate 时的独立视觉模型。
# CLI 的 --vision-provider / --vision-model / --vision-base-url 优先于这里的配置。
# VISION_PROVIDER 留空时使用主模型提供方；VISION_MODEL 在分离模式下必须填写或通过 CLI 指定。
VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=
# 留空时使用视觉提供方对应的上方密钥；自建 OpenAI 兼容服务可在此单独填写其密钥。
VISION_API_KEY=
